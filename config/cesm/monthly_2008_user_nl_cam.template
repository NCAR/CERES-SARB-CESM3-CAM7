! Generated from config/cesm/monthly_2008_v1.yaml.
! Analysis month: {month}; exclude the preceding ten model days in analysis.
! All CAM history and band optics include spinup, for verification and restartability.
ncdata = '{cam_initial_file}'

Nudge_Model = .true.
Nudge_Path = '{era5_directory}/'
Nudge_File_Template = 'ERA5_fv09.cam2.i.%y-%m-%d-%s.nc'
Nudge_Force_Opt = 0
Nudge_TimeScale_Opt = 0
Nudge_Times_Per_Day = 24
Model_Times_Per_Day = 48
Nudge_Uprof = 1
Nudge_Ucoef = 0.25
Nudge_Vprof = 1
Nudge_Vcoef = 0.25
Nudge_Tprof = 1
Nudge_Tcoef = 0.25
Nudge_Qprof = 1
Nudge_Qcoef = 0.25
Nudge_PSprof = 0
Nudge_PScoef = 0.00
Nudge_Beg_Year = {begin_year}
Nudge_Beg_Month = {begin_month}
Nudge_Beg_Day = {begin_day}
Nudge_End_Year = {end_year}
Nudge_End_Month = {end_month}
Nudge_End_Day = {end_day}
Nudge_Hwin_lat0 = 0.0
Nudge_Hwin_latWidth = 9999.
Nudge_Hwin_latDelta = 1.
Nudge_Hwin_lon0 = 180.
Nudge_Hwin_lonWidth = 9999.
Nudge_Hwin_lonDelta = 1.
Nudge_Hwin_Invert = .false.
Nudge_Vwin_Hindex = 33.
Nudge_Vwin_Hdelta = 0.001
Nudge_Vwin_Lindex = 0.
Nudge_Vwin_Ldelta = 0.1
Nudge_Vwin_Invert = .false.

aod_nudge_on = .true.
aod_beg_ymd = {aod_begin}
aod_end_ymd = {aod_end}
aod_obs_path = '{aod_directory}/'
aod_obs_template = 'MODIS_VIIRS_AOD_3hr_f09.%y%m%d.%s.nc'
aod_times_per_day = 8
aod_diag_on = .true.

aod_optics_on = .true.
aod_optics_interval_hours = 3
aod_optics_outdir = '{optics_directory}'
aod_optics_band_file = ''
aod_optics_lw_table = '{lw_table}'
aod_optics_method = 'lut'
aod_optics_lut_file = '{lut_file}'

empty_htapes = .true.
fincl1 = 'AODVIS','AODVISdn','AODNDG_OBS','AODNDG_MODEL_PRE','AODNDG_MODEL_POST','AODNDG_RATIO','AODNDG_MASK','FSNT','FSNTC','FLNT','FLNTC','FSNS','FSNSC','FLNS','FLNSC'
iradsw = -1
nhtfrq = -3
mfilt = 8
avgflag_pertape = 'I'
